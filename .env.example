# Server
HOST=0.0.0.0
PORT=7999

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queue and Exchange (auto-created if not exists)
QUEUE_NAME=block_update
EXCHANGE_NAME=block_update
EXCHANGE_TYPE=direct
ROUTING_KEY=block_update

# Authentication
AUTH_SERVICE_URL=http://localhost:8080/api/v1/token/verify/
JWT_ALGORITHMS=HS256
JWT_SECRET_KEY=your_secret_key_at_least_32_characters_long

# Performance
BLOCK_PORTION=500
MAX_CONCURRENT_SENDS=10
# Special users
ANONIM_USER=-1
